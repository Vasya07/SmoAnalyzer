<Window x:Class="SmoAnalyzer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SmoAnalyzer"
        Title="Анализ СМО — 14 практическая" Height="720" Width="1050"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>

        </Grid.ColumnDefinitions>
        
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Тип СМО" FontWeight="Bold" FontSize="14"/>

                <ComboBox SelectedValue="{Binding SelectedType}" SelectedValuePath="Tag">
                    <ComboBoxItem Tag="{x:Static local:SmoType.SingleRejection}">
                        1. Одноканальная с отказами
                    </ComboBoxItem>
                    <ComboBoxItem Tag="{x:Static local:SmoType.SingleLimited}">
                        2. Одноканальная с ограниченной очередью
                    </ComboBoxItem>
                    <ComboBoxItem Tag="{x:Static local:SmoType.SingleInfinite}">
                        3. Одноканальная с неограниченной очередью
                    </ComboBoxItem>
                    <ComboBoxItem Tag="{x:Static local:SmoType.MultiRejection}">
                        4. Многоканальная с отказами
                    </ComboBoxItem>
                    <ComboBoxItem Tag="{x:Static local:SmoType.MultiLimited}">
                        5. Многоканальная с ограниченной очередью
                    </ComboBoxItem>
                    <ComboBoxItem Tag="{x:Static local:SmoType.MultiInfinite}">
                        6. Многоканальная с неограниченной очередью
                    </ComboBoxItem>
                </ComboBox>

                <Separator Margin="0,8"/>
                <TextBlock Text="Интенсивность входного потока λ" FontWeight="Bold"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="120"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding Lambda}" Margin="0,2,8,8"/>
                    <ComboBox Grid.Column="1" SelectedIndex="{Binding LambdaUnitIndex}" Margin="0,2,0,8">
                        <ComboBoxItem>ед./ч</ComboBoxItem>
                        <ComboBoxItem>ед./мин</ComboBoxItem>
                        <ComboBoxItem>ед./сутки</ComboBoxItem>
                    </ComboBox>
                </Grid>

                <TextBlock Text="Способ задания обслуживания" FontWeight="Bold"/>
                <StackPanel Orientation="Horizontal">
                    <RadioButton Content="Интенсивность μ" GroupName="mode" IsChecked="{Binding UseMu, Mode=TwoWay}" Margin="0,0,12,8"/>
                    <RadioButton Content="Время обслуживания t" GroupName="mode" IsChecked="{Binding UseT, Mode=TwoWay}" Margin="0,0,0,8"/>
                </StackPanel>
                
                <StackPanel Visibility="{Binding VisibilityMuPanel}">
                    <TextBlock Text="Интенсивность обслуживания μ" FontWeight="Bold"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding Mu}" Margin="0,2,8,8"/>
                        <ComboBox Grid.Column="1" SelectedIndex="{Binding MuUnitIndex}" Margin="0,2,0,8">
                            <ComboBoxItem>ед./ч</ComboBoxItem>
                            <ComboBoxItem>ед./мин</ComboBoxItem>
                            <ComboBoxItem>ед./сутки</ComboBoxItem>
                        </ComboBox>
                    </Grid>
                </StackPanel>

                <StackPanel Visibility="{Binding VisibilityTPanel}">
                    <TextBlock Text="Среднее время обслуживания t"/>
                    <TextBox Text="{Binding ServiceTime}"/>
                    <TextBlock Text="Единица измерения"/>
                    <ComboBox SelectedIndex="{Binding TimeUnitIndex}">
                        <ComboBoxItem>Минуты</ComboBoxItem>
                        <ComboBoxItem>Часы</ComboBoxItem>
                        <ComboBoxItem>Сутки</ComboBoxItem>
                    </ComboBox>
                </StackPanel>

                <StackPanel Visibility="{Binding VisibilityChannels}">
                    <Separator Margin="0,8"/>
                    <TextBlock Text="Число каналов c" FontWeight="Bold"/>
                    <TextBox Text="{Binding Channels}"/>
                </StackPanel>
                
                <StackPanel Visibility="{Binding VisibilityQueueLimit}">
                    <Separator Margin="0,8"/>
                    <TextBlock Text="Максимальная длина очереди m" FontWeight="Bold"/>
                    <TextBox Text="{Binding QueueLimit}"/>
                </StackPanel>

                <Separator Margin="0,8"/>

                <Button Content="Рассчитать" Command="{Binding CalculateCommand}"
                        Background="#2D7FF9" Foreground="White" FontWeight="Bold"/>
                <TextBlock Text="{Binding ErrorText}" Foreground="DarkRed" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="{Binding VisibilityError}"/>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Column="2" BorderBrush="#DDD" BorderThickness="1" Padding="12">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{Binding ResultTitle}" FontWeight="Bold" FontSize="15" TextWrapping="Wrap" Margin="0,0,0,10"/>
                <DataGrid ItemsSource="{Binding ResultRows}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          AlternatingRowBackground="#F7F9FC">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Показатель" Binding="{Binding Key}" Width="*"/>
                        <DataGridTextColumn Header="Значение" Binding="{Binding Value}" Width="200"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</Window>